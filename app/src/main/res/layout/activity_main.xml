<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#F5F7FB">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Word Counter"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#283593"
            android:gravity="center"
            android:padding="12dp" />

        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:gravity="top|start"
            android:hint="Enter or edit your text here..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#3949AB" />

        <TextView
            android:id="@+id/wordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Words: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/characterCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Characters: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Text" />

        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Selected Text" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Selected Text" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Text Box" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Text History"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#283593"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <ListView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#CFD8DC"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>
